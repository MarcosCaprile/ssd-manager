{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "backend/**",
      "Dockerfile",
      ".dockerignore",
      "railway.cron.json"
    ]
  },
  "deploy": {
    "startCommand": "php cron/run_due_jobs.php",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
